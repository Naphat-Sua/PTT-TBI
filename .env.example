# Copy this file to `.env.local` and fill in your values.
# Vite exposes only variables prefixed with VITE_ to the client bundle —
# treat all of these as public at runtime and never put server-side
# secrets in a VITE_ variable.

# Google Gemini API key (https://aistudio.google.com/apikey) — required for
# the ChatTBU / TBIRAG / FullRAG AI features.
VITE_GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.0-flash).
# VITE_GEMINI_MODEL=gemini-2.0-flash

# Optional: URL of a remote backtest API. When unset, the AlgoTrade page
# runs its deterministic local backtest engine.
# VITE_BACKTEST_API_URL=

# Optional: base URL of the data-modeling backend (backend/app.py).
# Defaults to http://localhost:5000/api.
# VITE_DATA_API_URL=http://localhost:5000/api

# Optional: EmailJS credentials for the contact form
# (https://dashboard.emailjs.com). Defaults are built in for the demo.
# VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
